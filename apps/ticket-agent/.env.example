# BRAVE_API_KEY=your_brave_key_here         # https://api.search.brave.com ($3/mo, best quality)

# Deployment (Vercel or similar)
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_org_id
VERCEL_PROJECT_NAME=concert-sites
BASE_DOMAIN=yourdomain.com

# Social Media
