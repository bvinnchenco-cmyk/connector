# ── Telegram Bot ──────────────────────────────────────────────────────────────
TICKET_BOT_TOKEN=your_bot_token_here        # from @BotFather
ADMIN_TELEGRAM_IDS=123456789                # your Telegram user ID
TELEGRAM_CHANNEL_ID=@yourchannel           # channel where posts go (bot must be admin)

# ── AI ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Deployment ─────────────────────────────────────────────────────────────────
# Provide server details when ready (SSH or Vercel/Netlify token)
# VERCEL_TOKEN=
# BASE_DOMAIN=yourdomain.com

# ── Image search (optional — Wikipedia + DuckDuckGo work without any keys) ────
# LASTFM_API_KEY=      # free: https://www.last.fm/api/account/create
# BRAVE_API_KEY=       # $3/mo: https://api.search.brave.com

# ── Phase 1: Free social media testing ────────────────────────────────────────
# Twitter/X — free tier (1500 posts/month)
# Get keys at: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

