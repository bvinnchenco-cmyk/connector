# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connector

# JWT
JWT_SECRET=change_me_to_random_string_32chars

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Translation (free, self-hosted via Docker — no key needed)
LIBRETRANSLATE_URL=http://localhost:5000

# App
PORT=3000
NODE_ENV=development
UPLOAD_DIR=/tmp/connector-uploads

# AI Pipeline (local Python service)
AI_PIPELINE_URL=http://localhost:8000

# Supabase (optional — for cloud storage/db)
# SUPABASE_URL=https://[PROJECT].supabase.co
# SUPABASE_SERVICE_KEY=
